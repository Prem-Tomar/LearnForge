{
  "schema_version": 1,
  "issue_teaching": "self-contained",
  "teach_new_constructs_before_use": true,
  "revision_topic_days": [1, 3, 7, 10, 15],
  "revision_date_offsets": [0, 2, 6, 9, 14],
  "revision_days_allow_other_topics": true,
  "question_callout": "IMPORTANT",
  "max_main_issue_words": 450,
  "max_total_issue_words": 900,
  "api_documentation_requested": false,
  "core_queue": {"prepared": 7, "assigned": 7},
  "frontend_queue": {"prepared": 7, "assigned": 1, "separate_from_core": true},
  "research_hints_per_topic": 3,
  "project_rules_in_issues": false,
  "production_paths_use_feature_names": true,
  "reviews_require_actual_execution_or_explicit_not_executed": true,
  "review_feedback": {
    "mandatory": true,
    "applies_to_all_tracks": true,
    "plain_english": true,
    "explain_new_terms": true,
    "explicit_task_reference": true,
    "task_links_optional": true,
    "separate_bugs_suggestions_and_coaching": true,
    "required_parts": [
      "Where",
      "What happens now",
      "What the task asks for",
      "Why this does not meet the task",
      "Smallest change",
      "How to check"
    ]
  },
  "reference_patterns": [
    "https://github.com/Prem-Tomar/fieldops-mastery/issues/8",
    "https://github.com/Prem-Tomar/fieldops-mastery/issues/14",
    "https://github.com/Prem-Tomar/payment-api/issues/66",
    "https://github.com/Prem-Tomar/payment-api/issues/73"
  ]
}
